# Only what the image needs goes into the build context: never data, settings or secrets.
*
!Cargo.toml
!Cargo.lock
!clippy.toml
!crates/
!web/
!plugin/
!sandbox/sandboxd.py
!intake/discord/discord_intake.py
web/example.html
plugin/*/config.toml
# Secrets kept next to a plugin (e.g. plugin/discord/token) would end up in the image.
plugin/*/token
**/__pycache__
**/*.pyc
